# Copy to .env with: powershell -NoProfile -ExecutionPolicy Bypass -File .\infra\scripts\init-dev-env.ps1
# Never commit the generated .env file.

COMPOSE_PROJECT_NAME=class_archive
CLASS_ARCHIVE_HTTP_PORT=8088
CLASS_ARCHIVE_BASE_URL=http://localhost:8088
HUMHUB_DEBUG=true

# Immutable upstream images selected for Phase 0.
HUMHUB_IMAGE=humhub/humhub:1.18.4@sha256:8c4bee0edcc77de1104d154fc6ed2a20d5fa3a1eca700fdf0f96995377db1408
MARIADB_IMAGE=mariadb:11.8.8@sha256:d9f7eb2637296652f24b484afd5d246f759f49f5babcadc6a9e344c9acb75fbf

DB_NAME=humhub
DB_USER=humhub
DB_PASSWORD=__GENERATE_DB_PASSWORD__
DB_ROOT_PASSWORD=__GENERATE_DB_ROOT_PASSWORD__

# Local bootstrap administrator. The password is only read from the environment;
# HumHub stores its own password hash in MariaDB.
HUMHUB_ADMIN_USERNAME=classarchive-admin
HUMHUB_ADMIN_EMAIL=admin@class-archive.local
HUMHUB_ADMIN_PASSWORD=__GENERATE_ADMIN_PASSWORD__

# Future ClassIdentity secrets. Only keyed hashes/derivations are stored in the DB.
CLASS_ARCHIVE_CLAIM_CODE_PEPPER=__GENERATE_CLAIM_PEPPER__
CLASS_ARCHIVE_ANONYMOUS_PSEUDONYM_SECRET=__GENERATE_PSEUDONYM_SECRET__

# Optional integrations remain disabled in V1. Leave blank locally.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=
