# Copy to .env.piwigo with:
# powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\infra\scripts\init-dev-env.ps1
# Never commit the generated file.

COMPOSE_PROJECT_NAME=class_archive_piwigo
CLASS_ARCHIVE_HTTP_PORT=8090
CLASS_ARCHIVE_BASE_URL=http://localhost:8090
CLASS_ARCHIVE_TIMEZONE=Asia/Shanghai

# Set these to the owner of writable Piwigo data on a NAS deployment.
PIWIGO_UID=1000
PIWIGO_GID=1000

# Change these together when running more than one Class Archive instance.
PIWIGO_DATA_VOLUME=class_archive_piwigo_data
PIWIGO_UPLOADS_VOLUME=class_archive_piwigo_uploads
PIWIGO_GALLERIES_VOLUME=class_archive_piwigo_galleries
PIWIGO_DERIVATIVES_VOLUME=class_archive_piwigo_derivatives
PIWIGO_DB_VOLUME=class_archive_piwigo_db
PIWIGO_SCRIPTS_VOLUME=class_archive_piwigo_scripts
PIWIGO_BACKUPS_VOLUME=class_archive_piwigo_backups

# Immutable upstream images selected for the photo-first Phase 0 baseline.
# Image tag 16.4.0a packages Piwigo Core 16.4.0.
PIWIGO_IMAGE=piwigo/piwigo:16.4.0a@sha256:0ec6f159a3f972338b64e299d56ac37c442dd26cbeec39320d76ea826b5e0b84
MARIADB_IMAGE=mariadb:11.8.8@sha256:d9f7eb2637296652f24b484afd5d246f759f49f5babcadc6a9e344c9acb75fbf

DB_NAME=piwigo
DB_USER=piwigo
DB_PASSWORD=__GENERATE_DB_PASSWORD__
DB_ROOT_PASSWORD=__GENERATE_DB_ROOT_PASSWORD__

# Local bootstrap administrator. Fresh install prompts without echo for its
# one-time password; no administrator plaintext belongs in this file.
PIWIGO_ADMIN_USERNAME=classarchive-admin
PIWIGO_ADMIN_EMAIL=admin@class-archive.local

# Future ClassIdentity secrets. Only hashes/derivations may enter the database.
CLASS_ARCHIVE_CLAIM_CODE_PEPPER=__GENERATE_CLAIM_PEPPER__
CLASS_ARCHIVE_ANONYMOUS_PSEUDONYM_SECRET=__GENERATE_PSEUDONYM_SECRET__

# Optional integrations remain disabled in V1.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=
