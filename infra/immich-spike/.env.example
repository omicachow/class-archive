# This file is a template only. Copy it to the ignored infra/immich-spike/.env.
# It is intentionally separate from .env.piwigo and must never reuse its secrets.
# Names intentionally match the official Immich environment contract.
DB_PASSWORD=REPLACE_WITH_A_LOCAL_RANDOM_SECRET
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# These are volume names, not credentials. Match the values in .env.piwigo.
PIWIGO_UPLOADS_VOLUME=class_archive_piwigo_uploads
PIWIGO_GALLERIES_VOLUME=class_archive_piwigo_galleries
# Lets the static preflight use this non-secret template. Real startup omits
# this variable and uses the ignored .env file instead.
IMMICH_SPIKE_ENV_FILE=.env.example
TZ=Asia/Shanghai
