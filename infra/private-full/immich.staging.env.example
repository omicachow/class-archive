# Copy to ignored infra/private-full/.env.immich.staging. It names only
# private-full resources and never an original source directory.
IMMICH_COMPOSE_PROJECT_NAME=class_archive_private_full_v3_immich
CLASS_ARCHIVE_COMPAT_HTTP_PORT=8291
CLASS_ARCHIVE_CORE_PUBLIC_PORT=8290
CLASS_ARCHIVE_GATEWAY_NETWORK=class_archive_private_full_v3_gateway
PRIVATE_FULL_MANAGED_STORAGE_MODE=DOCKER_MANAGED_POSIX_VOLUMES
IMMICH_UPLOAD_VOLUME=class_archive_private_full_v3_immich_upload
IMMICH_MODEL_CACHE_VOLUME=class_archive_private_full_v3_immich_model_cache
IMMICH_DB_VOLUME=class_archive_private_full_v3_control_immich_db
IMMICH_GATEWAY_SECRET_VOLUME=class_archive_private_full_v3_control_immich_gateway_secret
PIWIGO_UPLOADS_VOLUME=class_archive_private_full_v3_piwigo_uploads
PIWIGO_GALLERIES_VOLUME=class_archive_private_full_v3_piwigo_galleries
DB_PASSWORD=__GENERATE_PRIVATE_FULL_IMMICH_DB_PASSWORD__
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
TZ=Asia/Shanghai
