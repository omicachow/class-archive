# Copy to ignored infra/private-full/.env.piwigo.staging. This is the
# blue/green candidate endpoint, never the owner endpoint.
COMPOSE_PROJECT_NAME=class_archive_private_full_v3_piwigo
CLASS_ARCHIVE_HTTP_PORT=8290
CLASS_ARCHIVE_COMPAT_HTTP_PORT=8291
CLASS_ARCHIVE_GATEWAY_NETWORK=class_archive_private_full_v3_gateway
CLASS_ARCHIVE_BASE_URL=http://127.0.0.1:8290
CLASS_ARCHIVE_TIMEZONE=Asia/Shanghai
# Runtime media uses Docker-managed POSIX volumes. The staging path is an
# owner-only, opaque sampler copy mounted read-only solely for import.
PRIVATE_FULL_MANAGED_STORAGE_MODE=DOCKER_MANAGED_POSIX_VOLUMES
FULL_REAL_STAGING_PATH=__SET_OWNER_ONLY_OPAQUE_STAGING_WSL_PATH__
FULL_REAL_IMPORT_MANIFEST_PATH=__SET_OWNER_ONLY_C_DRIVE_IMPORT_MANIFEST_WSL_PATH__
# Optional verified cache of locked Piwigo upstream archives. This is not a
# photo source and is mounted read-only into Piwigo.
PRIVATE_FULL_EXTENSION_CACHE_PATH=__SET_OWNER_ONLY_C_DRIVE_EXTENSION_CACHE_WSL_PATH__

PIWIGO_UID=1000
PIWIGO_GID=1000
PIWIGO_DATA_VOLUME=class_archive_private_full_v3_control_piwigo_data
PIWIGO_UPLOADS_VOLUME=class_archive_private_full_v3_piwigo_uploads
PIWIGO_GALLERIES_VOLUME=class_archive_private_full_v3_piwigo_galleries
PIWIGO_DERIVATIVES_VOLUME=class_archive_private_full_v3_piwigo_derivatives
PIWIGO_DB_VOLUME=class_archive_private_full_v3_control_piwigo_db
PIWIGO_SCRIPTS_VOLUME=class_archive_private_full_v3_control_piwigo_scripts
PIWIGO_BACKUPS_VOLUME=class_archive_private_full_v3_piwigo_backups

PIWIGO_IMAGE=piwigo/piwigo:16.4.0a@sha256:0ec6f159a3f972338b64e299d56ac37c442dd26cbeec39320d76ea826b5e0b84
MARIADB_IMAGE=mariadb:11.8.8@sha256:d9f7eb2637296652f24b484afd5d246f759f49f5babcadc6a9e344c9acb75fbf
DB_NAME=piwigo
DB_USER=piwigo
DB_PASSWORD=__GENERATE_PRIVATE_FULL_DB_PASSWORD__
DB_ROOT_PASSWORD=__GENERATE_PRIVATE_FULL_DB_ROOT_PASSWORD__
PIWIGO_ADMIN_USERNAME=private-full-admin
PIWIGO_ADMIN_EMAIL=admin@private-full.invalid
CLASS_ARCHIVE_CLAIM_CODE_PEPPER=__GENERATE_PRIVATE_FULL_CLAIM_PEPPER__
CLASS_ARCHIVE_ANONYMOUS_PSEUDONYM_SECRET=__GENERATE_PRIVATE_FULL_PSEUDONYM_SECRET__
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=
